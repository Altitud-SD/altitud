---
// Header.astro - Clean, Focused Navigation
import { siteConfig } from "../data/site";
import Button from "./ui/Button.astro";
---

<header class="sticky top-3 z-50 px-4 sm:px-6 lg:px-8 max-w-6xl mx-auto w-full">
  <div class="rounded-2xl px-4 sm:px-6 py-3 flex items-center justify-between border border-slate-200 shadow-sm backdrop-blur-xl bg-white/90">
    <!-- Brand Logo -->
    <a href="#" class="flex items-center gap-2.5 group focus:outline-none">
      <div class="w-8 h-8 rounded-xl bg-gradient-to-br from-[#0284C7] to-[#D4AF37] p-[1.5px] shadow-2xs">
        <div class="w-full h-full bg-white rounded-[9px] flex items-center justify-center">
          <svg class="w-4 h-4 text-[#0284C7]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <path d="m8 3 4 8 5-5 5 15H2L8 3z" />
            <circle cx="17" cy="6" r="2" class="fill-[#ECC35B] stroke-[#D4AF37]" />
          </svg>
        </div>
      </div>
      <span class="text-lg font-extrabold tracking-tight text-slate-900">
        {siteConfig.brandName}<span class="text-[#0284C7]">.</span>
      </span>
    </a>

    <!-- Desktop Navigation -->
    <nav class="hidden md:flex items-center gap-1">
      {siteConfig.navigation.map((item) => (
        <a
          href={item.href}
          class="px-3.5 py-1.5 text-sm font-semibold text-slate-600 hover:text-slate-900 rounded-lg hover:bg-slate-100/60 transition-all"
        >
          {item.label}
        </a>
      ))}
    </nav>

    <!-- Header Actions -->
    <div class="flex items-center gap-3">
      <!-- Primary Gold CTA Button -->
      <Button href="#contacto" variant="primary-gold" size="sm">
        <span>Contactar</span>
        <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
          <path d="M5 12h14" />
          <path d="m12 5 7 7-7 7" />
        </svg>
      </Button>

      <!-- Mobile Menu Toggle Button -->
      <button
        id="mobile-menu-btn"
        type="button"
        aria-label="Abrir menú"
        class="md:hidden p-2 text-slate-600 hover:text-slate-900 rounded-lg hover:bg-slate-100 focus:outline-none"
      >
        <svg id="menu-icon" class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16" />
        </svg>
      </button>
    </div>
  </div>

  <!-- Mobile Dropdown Menu -->
  <div id="mobile-menu" class="hidden md:hidden mt-2 p-3 rounded-2xl border border-slate-200 shadow-lg bg-white transition-all">
    <div class="flex flex-col gap-1">
      {siteConfig.navigation.map((item) => (
        <a href={item.href} class="mobile-nav-link px-3 py-2 text-sm font-semibold text-slate-700 hover:text-[#0284C7] hover:bg-slate-50 rounded-lg">
          {item.label}
        </a>
      ))}
    </div>
  </div>
</header>

<script>
  const btn = document.getElementById("mobile-menu-btn");
  const menu = document.getElementById("mobile-menu");
  const links = document.querySelectorAll(".mobile-nav-link");

  btn?.addEventListener("click", () => {
    menu?.classList.toggle("hidden");
  });

  links.forEach((link) => {
    link.addEventListener("click", () => {
      menu?.classList.add("hidden");
    });
  });
</script>
