---
// Footer.astro - Clean, Minimal Footer
import { siteConfig } from "../data/site";
---

<footer class="mt-auto border-t border-slate-200 bg-[#FAF9F6] pt-12 pb-10">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex flex-col md:flex-row items-center justify-between gap-6 pb-8 border-b border-slate-200">
      
      <!-- Brand & Info -->
      <div class="flex flex-col sm:flex-row items-center gap-4 text-center sm:text-left">
        <span class="text-lg font-black tracking-tight text-slate-900">
          {siteConfig.brandName}<span class="text-[#0284C7]">.</span>
        </span>
        <span class="text-xs text-slate-500">
          {siteConfig.footer.colophon}
        </span>
      </div>

      <!-- Quick Nav -->
      <div class="flex flex-wrap items-center justify-center gap-6 text-xs font-semibold text-slate-600">
        {siteConfig.navigation.map((item) => (
          <a href={item.href} class="hover:text-[#0284C7] transition-colors">
            {item.label}
          </a>
        ))}
        <a href={siteConfig.contact.whatsappUrl} target="_blank" rel="noopener noreferrer" class="text-[#8D6607] font-bold hover:underline">
          WhatsApp Directo
        </a>
      </div>

    </div>

    <!-- Bottom Copyright -->
    <div class="pt-6 flex flex-col sm:flex-row items-center justify-between gap-3 text-xs text-slate-400">
      <p>© {new Date().getFullYear()} {siteConfig.brandName}. Software a medida y soluciones digitales.</p>
      <p class="text-slate-500">{siteConfig.contact.location}</p>
    </div>
  </div>
</footer>
