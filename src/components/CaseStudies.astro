---
// CaseStudies.astro - Clean, High-Readability Case Studies
import { caseStudiesData } from "../data/cases";
import Badge from "./ui/Badge.astro";
import CaseCard from "./cards/CaseCard.astro";
---

<section id="casos" class="py-16 sm:py-20 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
  <!-- Section Header -->
  <div class="text-center max-w-2xl mx-auto mb-12">
    <Badge variant="gold" class="mb-4 uppercase font-bold">
      {caseStudiesData.badge}
    </Badge>
    <h2 class="text-3xl sm:text-4xl font-extrabold text-slate-900 tracking-tight mb-4">
      {caseStudiesData.title}
    </h2>
    <p class="text-base text-slate-600 leading-relaxed">
      {caseStudiesData.subtitle}
    </p>
  </div>

  <!-- Showcase List -->
  <div class="space-y-6">
    {caseStudiesData.cases.map((study) => (
      <CaseCard caseStudy={study} />
    ))}
  </div>
</section>
