---
// ContactSection.astro - Clean, High-Conversion Contact Form
import { contactData } from "../data/contact";
import Badge from "./ui/Badge.astro";
import Button from "./ui/Button.astro";
---

<section id="contacto" class="py-16 sm:py-20 max-w-4xl mx-auto px-4 sm:px-6">
  <div class="rounded-3xl p-8 sm:p-12 bg-white border border-slate-200/90 shadow-lg">
    
    <!-- Header -->
    <div class="text-center max-w-xl mx-auto mb-10">
      <Badge variant="gold" class="mb-4 uppercase font-bold">
        {contactData.badge}
      </Badge>
      <h2 class="text-3xl sm:text-4xl font-extrabold text-slate-900 tracking-tight mb-3">
        {contactData.title}
      </h2>
      <p class="text-sm sm:text-base text-slate-600 leading-relaxed">
        {contactData.subtitle}
      </p>
    </div>

    <!-- Form -->
    <form id="contact-form" class="space-y-6 max-w-2xl mx-auto">
      
      <!-- Option Selector -->
      <div>
        <label class="block text-xs font-bold uppercase tracking-wider text-slate-700 mb-2.5">
          ¿Qué tipo de solución buscas?
        </label>
        <div class="grid grid-cols-2 sm:grid-cols-4 gap-2">
          {contactData.options.map((opt, idx) => (
            <button
              type="button"
              class={`need-pill px-3 py-2 rounded-xl text-xs font-semibold text-center transition-all border border-slate-200 bg-slate-50 text-slate-700 hover:border-[#0284C7] hover:bg-white ${idx === 0 ? 'active-need' : ''}`}
              data-need={opt}
            >
              {opt}
            </button>
          ))}
        </div>
        <input type="hidden" id="selected-need" name="selected_need" value={contactData.options[0]} />
      </div>

      <!-- Inputs: Name & Contact -->
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        <div>
          <label for="name" class="block text-xs font-bold text-slate-700 mb-1.5">Tu Nombre y Apellido *</label>
          <input
            type="text"
            id="name"
            name="name"
            required
            placeholder="Ej. Martín Gómez"
            class="w-full px-4 py-3 rounded-xl bg-slate-50 border border-slate-200 text-slate-900 placeholder-slate-400 text-sm focus:bg-white focus:outline-none focus:border-[#0284C7] focus:ring-2 focus:ring-[#BAE6FD] transition-all"
          />
        </div>
        <div>
          <label for="contact-info" class="block text-xs font-bold text-slate-700 mb-1.5">Email o WhatsApp *</label>
          <input
            type="text"
            id="contact-info"
            name="contact_info"
            required
            placeholder="martin@empresa.com o +54 9 11..."
            class="w-full px-4 py-3 rounded-xl bg-slate-50 border border-slate-200 text-slate-900 placeholder-slate-400 text-sm focus:bg-white focus:outline-none focus:border-[#0284C7] focus:ring-2 focus:ring-[#BAE6FD] transition-all"
          />
        </div>
      </div>

      <!-- Message -->
      <div>
        <label for="message" class="block text-xs font-bold text-slate-700 mb-1.5">¿Qué te gustaría resolver o construir? *</label>
        <textarea
          id="message"
          name="message"
          rows="3"
          required
          placeholder="Cuéntanos brevemente sobre tu negocio o qué proceso te quita más tiempo..."
          class="w-full px-4 py-3 rounded-xl bg-slate-50 border border-slate-200 text-slate-900 placeholder-slate-400 text-sm focus:bg-white focus:outline-none focus:border-[#0284C7] focus:ring-2 focus:ring-[#BAE6FD] transition-all resize-none"
        ></textarea>
      </div>

      <!-- Submit CTA Button -->
      <Button type="submit" variant="primary-gold" size="lg" class="w-full shadow-md cursor-pointer">
        <span>Enviar mensaje y recibir propuesta</span>
        <svg class="w-5 h-5 transition-transform duration-300 group-hover:translate-x-1" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
          <path d="M5 12h14" />
          <path d="m12 5 7 7-7 7" />
        </svg>
      </Button>

      <!-- Trust Badges Under Button -->
      <div class="flex flex-wrap items-center justify-center gap-6 pt-2 text-xs text-slate-500">
        {contactData.trustNotes.map((note) => (
          <div class="flex items-center gap-1.5 font-medium">
            <span class="text-emerald-600 font-bold">✓</span>
            <span>{note}</span>
          </div>
        ))}
      </div>

      <!-- Fast WhatsApp / Calendar Alternative -->
      <div class="pt-6 border-t border-slate-100 flex flex-col sm:flex-row items-center justify-between gap-3 text-xs">
        <a
          href={contactData.directWhatsappUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="font-bold text-emerald-700 hover:text-emerald-800 flex items-center gap-1"
        >
          <span>💬 {contactData.directWhatsappText}</span>
          <span>→</span>
        </a>
        <a
          href={contactData.directCalendarUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="font-bold text-[#0284C7] hover:text-[#0369A1] flex items-center gap-1"
        >
          <span>📅 {contactData.directCalendarText}</span>
          <span>↗</span>
        </a>
      </div>

    </form>
  </div>
</section>

<style>
  .need-pill.active-need {
    background: #FEF9EE;
    border-color: #D4AF37;
    color: #8D6607;
    box-shadow: 0 1px 3px rgba(212, 175, 55, 0.25);
  }
</style>

<script>
  const pills = document.querySelectorAll<HTMLButtonElement>(".need-pill");
  const hiddenInput = document.getElementById("selected-need") as HTMLInputElement;

  pills.forEach((pill) => {
    pill.addEventListener("click", () => {
      pills.forEach((p) => p.classList.remove("active-need"));
      pill.classList.add("active-need");
      const val = pill.getAttribute("data-need");
      if (val && hiddenInput) {
        hiddenInput.value = val;
      }
    });
  });
</script>
