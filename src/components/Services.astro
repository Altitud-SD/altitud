---
// Services.astro - Clean, High-Readability Section
import { servicesData } from "../data/services";
import Badge from "./ui/Badge.astro";
import ServiceCard from "./cards/ServiceCard.astro";
---

<section id="servicios" class="py-16 sm:py-20 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
  <!-- Section Header -->
  <div class="text-center max-w-2xl mx-auto mb-12">
    <Badge variant="sky" class="mb-4 uppercase font-bold">
      {servicesData.badge}
    </Badge>
    <h2 class="text-3xl sm:text-4xl font-extrabold text-slate-900 tracking-tight mb-4">
      {servicesData.title}
    </h2>
    <p class="text-base text-slate-600 leading-relaxed">
      {servicesData.subtitle}
    </p>
  </div>

  <!-- Grid of 3 Clear Services -->
  <div class="grid grid-cols-1 md:grid-cols-3 gap-6 sm:gap-8">
    {servicesData.services.map((service) => (
      <ServiceCard service={service} />
    ))}
  </div>
</section>
