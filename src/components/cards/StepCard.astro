---
// StepCard.astro
import type { MethodologyStep } from "../../data/about";

interface Props {
  step: MethodologyStep;
}

const { step } = Astro.props;
---

<div
  class={`p-7 rounded-2xl paper-card relative group transition-all duration-300 bg-white ${
    step.isAccent
      ? "border-[#F1DEAC] hover:border-[#D4AF37]"
      : "border-slate-200/80 hover:border-[#0284C7]/40"
  }`}
>
  <div class="flex items-center justify-between mb-4">
    <span
      class={`text-2xl font-mono font-black ${
        step.isAccent ? "text-[#B8860B]" : "text-[#0284C7]"
      }`}
    >
      {step.number}
    </span>
    <span class="text-[11px] font-bold uppercase tracking-wider text-slate-400">
      {step.title}
    </span>
  </div>

  <h4 class="text-base font-bold text-slate-900 mb-2 leading-snug">
    {step.humanTitle}
  </h4>
  <p class="text-xs sm:text-sm text-slate-600 leading-relaxed">
    {step.description}
  </p>
</div>
