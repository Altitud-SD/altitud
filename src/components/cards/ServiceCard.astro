---
// ServiceCard.astro - Clean, High-Legibility Card
import type { ServiceItem } from "../../data/services";

interface Props {
  service: ServiceItem;
}

const { service } = Astro.props;
---

<div class="paper-card rounded-2xl p-7 sm:p-8 flex flex-col justify-between bg-white border border-slate-200/80 shadow-xs hover:border-[#0284C7]/40 transition-all">
  <div>
    <!-- Icon & Header -->
    <div class="w-12 h-12 rounded-xl bg-[#F0F9FF] border border-[#BAE6FD] flex items-center justify-center text-[#0284C7] mb-6">
      {service.icon === "layout" && (
        <svg class="w-6 h-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <rect width="18" height="18" x="3" y="3" rx="2" />
          <path d="M3 9h18" />
          <path d="M9 21V9" />
        </svg>
      )}
      {service.icon === "smartphone" && (
        <svg class="w-6 h-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <rect width="14" height="20" x="5" y="2" rx="2" ry="2" />
          <path d="M12 18h.01" />
        </svg>
      )}
      {service.icon === "zap" && (
        <svg class="w-6 h-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2" />
        </svg>
      )}
    </div>

    <!-- Title -->
    <h3 class="text-xl font-bold text-slate-900 mb-2">
      {service.title}
    </h3>

    <!-- Ideal For Highlight -->
    <p class="text-xs font-semibold text-[#0284C7] mb-4">
      {service.idealFor}
    </p>

    <!-- Description -->
    <p class="text-sm text-slate-600 leading-relaxed mb-6">
      {service.description}
    </p>

    <!-- Benefits Checklist -->
    <ul class="space-y-2.5 pt-4 border-t border-slate-100 mb-6">
      {service.benefits.map((benefit) => (
        <li class="flex items-start gap-2.5 text-xs sm:text-sm text-slate-700">
          <svg class="w-4 h-4 text-[#D4AF37] shrink-0 mt-0.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
            <polyline points="20 6 9 17 4 12" />
          </svg>
          <span>{benefit}</span>
        </li>
      ))}
    </ul>
  </div>

  <!-- Bottom Action -->
  <a href="#contacto" class="inline-flex items-center gap-1.5 text-xs font-bold text-[#0284C7] hover:text-[#0369A1] transition-colors pt-2">
    <span>Consultar por este servicio</span>
    <span>→</span>
  </a>
</div>
