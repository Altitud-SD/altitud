---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
---

<Layout title="404 | Página no encontrada - Altitud">
  <Header />
  <main class="flex-1 flex items-center justify-center py-28 px-4">
    <div class="text-center max-w-lg mx-auto glass-panel p-10 rounded-3xl border border-white/10 relative">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-[#F59E0B]/10 border border-[#F59E0B]/20 text-[#FBBF24] text-xs font-semibold mb-6">
        <span>Error 404</span>
      </div>
      <h1 class="text-5xl font-extrabold text-white mb-4">Página no encontrada</h1>
      <p class="text-slate-300 text-sm mb-8 leading-relaxed">
        La ruta a la que intentas acceder no existe o ha sido reubicada. Regresa al inicio para conocer nuestras soluciones de software.
      </p>
      <a
        href="/"
        class="inline-flex items-center justify-center gap-2 px-6 py-3.5 rounded-xl text-sm font-bold text-slate-950 bg-gradient-to-r from-[#FBBF24] via-[#F59E0B] to-[#D97706] hover:from-[#FDE68A] hover:to-[#F59E0B] shadow-lg shadow-[#F59E0B]/25 transition-all"
      >
        <span>Volver al Inicio</span>
        <span>→</span>
      </a>
    </div>
  </main>
  <Footer />
</Layout>

