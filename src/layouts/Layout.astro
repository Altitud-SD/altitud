---
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Altitud | Software con Propósito & Soluciones Digitales Humanas",
  description = "Creamos software a medida y herramientas digitales pensadas para personas reales: simplificando el día a día de empresas y equipos con dedicación artesanal.",
} = Astro.props;
---

<!doctype html>
<html lang="es" class="scroll-smooth bg-[#FAF9F6] text-[#334155] antialiased selection:bg-[#BAE6FD] selection:text-[#0F172A]">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />

    <title>{title}</title>
    <meta name="description" content={description} />

    <!-- Google Fonts: Plus Jakarta Sans & Inter -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=Plus+Jakarta+Sans:wght@500;600;700;800&family=Newsreader:ital,opsz,wght@1,6..72,400;1,6..72,500&display=swap"
      rel="stylesheet"
    />
  </head>
  <body class="min-h-screen bg-[#FAF9F6] text-[#334155] overflow-x-hidden relative">
    <!-- Luz natural y atmósfera cálida de fondo -->
    <div class="fixed inset-0 pointer-events-none z-0 overflow-hidden">
      <!-- Luz Solar Suave / Sol de Mayo en la parte superior -->
      <div class="absolute -top-[12%] left-1/2 -translate-x-1/2 w-[850px] h-[550px] bg-[#FEF3C7]/45 rounded-full blur-[140px]"></div>
      <!-- Respiro Celeste Luminoso en el lateral -->
      <div class="absolute top-[25%] -right-[100px] w-[600px] h-[600px] bg-[#E0F2FE]/50 rounded-full blur-[160px]"></div>
      <!-- Toque de calidez en el fondo -->
      <div class="absolute bottom-[15%] -left-[100px] w-[500px] h-[500px] bg-[#FEF9EE]/60 rounded-full blur-[150px]"></div>
      <!-- Cuadrícula sutil de cuaderno de diseño -->
      <div class="absolute inset-0 bg-[linear-gradient(to_right,#0f172a06_1px,transparent_1px),linear-gradient(to_bottom,#0f172a06_1px,transparent_1px)] bg-[size:3.5rem_3.5rem] [mask-image:radial-gradient(ellipse_70%_60%_at_50%_0%,#000_80%,transparent_100%)]"></div>
    </div>

    <!-- Main Application Slot -->
    <div class="relative z-10 flex flex-col min-h-screen">
      <slot />
    </div>
  </body>
</html>
